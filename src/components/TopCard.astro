---
import { Picture } from 'astro:assets';
import { foto } from '../lib/fotos';

interface Props {
  top: {
    id: number;
    slug: string;
    nombre: string;
    ranking: string;
    peso: string;
    foto: { src: string; width: number; height: number; alt: string };
  };
}

const { top } = Astro.props;
---

<div class="top-1 fade-in" data-tilt>
  <div class="numero-top">{top.ranking}</div>
  <Picture
    src={foto(top.foto.src)}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[220, 360, 520]}
    sizes="(max-width: 560px) 42vw, 300px"
    alt={top.foto.alt}
    loading="lazy"
    decoding="async"
  />
  <h2>{top.nombre}</h2>
  <p>Peso: <span>{top.peso}</span></p>
  <a href={`/detalles-tops/${top.slug}`} class="btn-detalles">Ver detalles</a>
</div>
