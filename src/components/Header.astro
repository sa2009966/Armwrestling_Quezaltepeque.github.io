---
import { Image } from 'astro:assets';
import { foto } from '../lib/fotos';

const paginas = [
  { href: '/', texto: 'Inicio' },
  { href: '/2nosotros', texto: 'Nosotros' },
  { href: '/3top', texto: 'Top' },
  { href: '/4eventos', texto: 'Eventos' },
  { href: '/5contactos', texto: 'Contactos' },
];
const actual = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
  <div class="container-logo">
    <Image
      src={foto('/fotos/logo1x1.webp')}
      widths={[96, 192, 288]}
      sizes="96px"
      width={96}
      height={99}
      alt="Logo de Armwrestling Quezaltepeque"
      class="logo"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="container-icon-menu" id="icon">☰</div>
  <div class="container-menu" id="menu">
    {paginas.map(p => (
      <a href={p.href} class="paginas" aria-current={actual === p.href ? 'page' : undefined}>
        <h3>{p.texto}</h3>
      </a>
    ))}
  </div>
  <div id="overlay" class="overlay"></div>
</header>
