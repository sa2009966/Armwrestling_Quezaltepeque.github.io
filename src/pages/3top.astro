---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import tops from '../data/tops.json';
import { foto } from '../lib/fotos';

const fila = (t) => {
  const [g, p] = t.record.marcador.split('-');
  return { ...t, ganadas: g.trim(), perdidas: p.trim() };
};
const filas = tops.map(fila);
---

<BaseLayout
  title="Ranking de lucha de brazos | Armwrestling Quezaltepeque"
  description="Conoce el ranking de los atletas más fuertes de Armwrestling Quezaltepeque. Consulta perfiles, récords y detalles de cada luchador del club."
  canonical="/3top"
  ogImage="/fotos/top-banner.webp"
>
  <main>
    <section class="top-inicio">
      <div class="container-top">
        <div class="container-texto-top">
          <span class="tag">
            <h5>Ranking del club</h5>
          </span>
          <hr>
          <h1>TOPS MÁS FUERTES</h1>
          <span class="tag">El ranking se gana en la mesa.</span>
          <p>En Quezaltepeque, el respeto se gana brazo a brazo. <br> Este es el ranking actual de los atletas más
            fuertes del club.</p>
          <a href="#top" class="btn7 fade-in"><i class="ri-function-line"></i> Ver tops </a>
        </div>
      </div>
      <div class="top-inicio-img">
        <Image
          src={foto('/fotos/top-banner.webp')}
          widths={[480, 768, 1200, 1386]}
          sizes="100vw"
          alt="Atletas entrenando lucha de brazos"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>

    <section id="top" class="inicio-tops">
      <h2 class="standings-title fade-in">CLASIFICACIÓN <span>· TEMPORADA {new Date().getFullYear()}</span></h2>
      <ol class="standings">
        {filas.map(top => (
          <li class="standing fade-in">
            <span class="standing-pos">{top.ranking}</span>
            <Image
              class="standing-foto"
              src={foto(top.foto.src)}
              widths={[64, 128]}
              sizes="64px"
              width={64}
              height={90}
              alt={top.foto.alt}
              loading="lazy"
              decoding="async"
            />
            <div class="standing-info">
              <strong>{top.nombre}</strong>
              <span>{top.peso} · {top.estilo}</span>
            </div>
            <div class="standing-record">
              <b data-count={top.ganadas}>{top.ganadas}</b>–<i data-count={top.perdidas}>{top.perdidas}</i>
              <small>{top.record.porcentaje}</small>
            </div>
            <a class="standing-link" href={`/detalles-tops/${top.slug}`} aria-label={`Ver ficha de ${top.nombre}`}>Ficha</a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>
