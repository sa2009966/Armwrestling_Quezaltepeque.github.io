---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---

<BaseLayout
  title="Contactos | Armwrestling Quezaltepeque"
  description="Únete al club de lucha de brazos de Quezaltepeque. Contáctanos por WhatsApp, TikTok o Instagram y entrena con nosotros los domingos en La Libertad."
  canonical="/5contactos"
  footer="eventos"
>
  <main>
    <section class="redes fade-in">
      <h1>Únete al club</h1>
      <p>Solicita información sobre nuestros programas y conviértete en parte de nuestra familia.</p>

      <div class="contacto1 fade-in">
        <div class="icon-contacto1"><i class="ri-whatsapp-line"></i></div>
        <p class="p-1">Respuesta rápida</p>
        <h3>¿Prefieres hablar directamente?</h3>
        <p class="p-2">Escríbenos por WhatsApp y te respondemos en minutos. Es la forma más rápida de resolver tus
          dudas
          y poder unirte a nuestra comunidad.</p>
        <a href={site.contactos.whatsapp} target="_blank" rel="noopener" class="btn9"><i
            class="ri-whatsapp-line"></i> Hablar por WhatsApp</a>
      </div>
      <div class="contacto2 fade-in">
        <div class="icon-contacto2"><i class="ri-tiktok-fill"></i></div>
        <p class="p-1">Síguenos en TikTok</p>
        <h3>Armwrestling Quezaltepeque</h3>
        <p class="p-2">Contáctenos a nuestra página de TikTok para ver más información.</p>
        <a href={site.contactos.tiktok} target="_blank" rel="noopener" class="btn10"><i
            class="ri-tiktok-fill"></i> Ver
          perfil de TikTok</a>
      </div>
      <div class="contacto3 fade-in">
        <div class="icon-contacto3"><i class="ri-instagram-line"></i></div>
        <p class="p-1">Síguenos en Instagram</p>
        <h3>Armwrestling Quezaltepeque</h3>
        <p class="p-2">Contáctenos a nuestra página de Instagram para ver más información.</p>
        <a href={site.contactos.instagram} target="_blank" rel="noopener" class="btn11"><i
            class="ri-instagram-line"></i> Ver perfil de Instagram</a>
      </div>
    </section>

    <section class="redes2 fade-in">
      <div class="contacto21">
        <div class="icon-contacto21"><i class="ri-map-pin-line"></i></div>
        <p class="p-1">Ubicación</p>
        <p class="p-2">Quezaltepeque, El Salvador.</p>
      </div>
      <div class="contacto22">
        <div class="icon-contacto22"><i class="ri-time-line"></i></div>
        <p class="p-1">Horario de entrenamientos</p>
        <p class="p-2">Domingos, 1:00 PM – 4:00 PM</p>
      </div>
    </section>

    <section class="form-section fade-in" id="formulario">
      <p class="p-1">Formulario</p>
      <h2>Escríbenos</h2>
      <p class="form-sub">Déjanos tu mensaje y te respondemos lo antes posible.</p>

      <form id="form-contacto" class="fade-in" novalidate>
        <input type="hidden" name="access_key" value={site.form.accessKey}>
        <input type="checkbox" name="botcheck" class="hidden-botcheck" style="display:none" tabindex="-1">

        <div class="form-grid">
          <label>
            <span>Nombre</span>
            <input type="text" name="nombre" required maxlength="80" placeholder="Tu nombre">
          </label>
          <label>
            <span>WhatsApp o correo</span>
            <input type="text" name="contacto" required maxlength="120" placeholder="Cómo te contactamos">
          </label>
        </div>
        <label>
          <span>Mensaje</span>
          <textarea name="mensaje" rows="4" required maxlength="1000"
            placeholder="Cuéntanos qué quieres saber: horarios, ubicación, cómo unirte..."></textarea>
        </label>

        <button type="submit" class="btn-form"><i class="ri-send-ins-line"></i> Enviar mensaje</button>
        <p id="form-estado" class="form-estado" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <script>
    const formsVinculados = new WeakSet();

    function vincularFormulario() {
      const form = document.getElementById('form-contacto');
      const estadoEl = document.getElementById('form-estado');
      if (!form || !estadoEl || formsVinculados.has(form)) return;
      formsVinculados.add(form);

    function setEstado(texto, esError = false, esExito = false) {
      estadoEl.textContent = texto;
      estadoEl.className = 'form-estado' + (esError ? ' error' : '') + (esExito ? ' ok' : '');
    }

    form.addEventListener('submit', async e => {
      e.preventDefault();
      const btn = form.querySelector('button');
      const datos = Object.fromEntries(new FormData(form));

      if (datos.access_key === 'TU_ACCESS_KEY_DE_WEB3FORMS') {
        setEstado('⚠️ Configura tu access key de Web3Forms en src/data/site.json', true);
        return;
      }

      btn.disabled = true;
      setEstado('Enviando…');
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(datos)
        });
        const json = await res.json();
        if (res.ok && json.success) {
          setEstado('¡Mensaje enviado! Te responderemos pronto.', false, true);
          form.reset();
        } else {
          setEstado(json.message || 'No se pudo enviar. Escríbenos por WhatsApp.', true);
        }
      } catch {
        setEstado('Error de conexión. Escríbenos por WhatsApp.', true);
      } finally {
        btn.disabled = false;
      }
    });
    }

    // Primera carga + navegaciones cliente (ClientRouter)
    vincularFormulario();
    document.addEventListener('astro:page-load', vincularFormulario);
  </script>
</BaseLayout>
