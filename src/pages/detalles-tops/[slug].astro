---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import tops from '../../data/tops.json';
import site from '../../data/site.json';
import { foto } from '../../lib/fotos';

export function getStaticPaths() {
  return tops.map((top, i) => ({
    params: { slug: top.slug },
    props: { top, i },
  }));
}

const { top, i } = Astro.props;
const prev = tops[(i - 1 + tops.length) % tops.length];
const next = tops[(i + 1) % tops.length];
const stats = [
  { label: 'Fuerza', valor: top.stats.fuerza, icono: 'ri-arrow-up-long-fill' },
  { label: 'Velocidad', valor: top.stats.velocidad, icono: 'ri-flashlight-line' },
  { label: 'Resistencia', valor: top.stats.resistencia, icono: 'ri-shield-line' },
  { label: 'Técnica', valor: top.stats.tecnica, icono: 'ri-brain-line' },
];
---

<BaseLayout
  title={top.seo.title}
  description={top.seo.description}
  canonical={`/detalles-tops/${top.slug}`}
  ogImage={top.foto.src}
>
  <main>
    <section class="info-1">
      <span class="watermark" aria-hidden="true">{i + 1}</span>
      <div class="estaditicas1">
        <h3>{top.nombre}</h3>
        <p><img src="/fotos/flag-sv.webp" width="128" height="72" alt="bandera de El Salvador"> {top.pais}</p>
        <p>Peso: <br> <span>{top.peso}</span></p>
        <p>Altura: <br> <span>{top.altura}</span></p>
        <p>Edad: <br> <span>{top.edad}</span></p>
        <p>Estilo: <br> <span>{top.estilo}</span></p>
        <p>Mano dominante: <br> <span>{top.mano}</span></p>
      </div>
      <div class="foto-detalles">
        <Image
          src={foto(top.foto.src)}
          widths={[400, 640, 900]}
          sizes="(max-width: 860px) 92vw, 480px"
          alt={top.foto.alt}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="posicionamiento">
        <div class="ranking">
          <p>Ranking: <br> <span>{top.ranking}</span></p>
        </div>
        <div class="record">
          <p>Récord:<br> <span>{top.record.marcador}</span> <br> <span>({top.record.porcentaje})</span></p>
        </div>
      </div>
      <div class="estaditicas-mobil">
        <h3>{top.nombre}</h3>
        <p><img src="/fotos/flag-sv.webp" width="128" height="72" alt="bandera de El Salvador"> {top.pais}</p>
        <p>Peso: <span>{top.peso}</span></p>
        <p>Altura: <span>{top.altura}</span></p>
        <p>Edad: <span>{top.edad}</span></p>
        <p>Estilo: <span>{top.estilo}</span></p>
        <p>Mano dominante: <span>{top.mano}</span></p>
      </div>
    </section>

    <section class="info-2">
      <div class="estadisticas2">
        {stats.map(s => (
          <div class="estaditica fade-in">
            <div class="estadistica-icon"><i class={s.icono}></i></div>
            <div class="estadistica-texto">
              {s.label}: <br>
              <p><span data-count={s.valor}>{s.valor}</span><span>/100</span></p>
            </div>
            <div class="stat-bar" aria-hidden="true"><span style={`--v:${s.valor}`}></span></div>
          </div>
        ))}
      </div>

      <div class="historial-combates">
        <div class="card">
          <h2>Historial de combates</h2>
          <table>
            <thead>
              <tr>
                <th>Rival</th>
                <th>Resultado</th>
                <th>Marcador</th>
                <th>Fecha</th>
              </tr>
            </thead>
            <tbody>
              {top.combates.map(c => (
                <tr>
                  <td>{c.rival}</td>
                  <td><span class={c.clase}>{c.resultado}</span></td>
                  <td>{c.marcador}</td>
                  <td>{c.fecha}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="combates-mobile">
        {top.combates.map(c => (
          <div class="combate-card fade-in">
            <h3>{c.rival}</h3>
            <p><strong>Resultado:</strong> <span class={c.clase}>{c.resultado}</span></p>
            <p><strong>Marcador:</strong> {c.marcador}</p>
            <p><strong>Fecha:</strong> {c.fecha}</p>
          </div>
        ))}
      </div>
    </section>

    <nav class="ficha-nav" aria-label="Otros luchadores del ranking">
      <a href={`/detalles-tops/${prev.slug}`}><i class="ri-arrow-left-line"></i> <span>{prev.nombre}</span></a>
      <a href="/3top"><i class="ri-list-ordered"></i> Ranking</a>
      <a href={`/detalles-tops/${next.slug}`}><span>{next.nombre}</span> <i class="ri-arrow-right-line"></i></a>
    </nav>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: top.nombre,
    description: top.seo.description,
    image: `${site.dominio}${top.foto.src}`,
    nationality: 'Salvadoran',
    memberOf: {
      '@type': 'SportsOrganization',
      name: site.nombre,
      url: `${site.dominio}/`
    }
  })} />
</BaseLayout>
