---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import evento from '../data/evento.json';
import site from '../data/site.json';
import { foto } from '../lib/fotos';
---

<BaseLayout
  title="Eventos y Vendettas | Armwrestling Quezaltepeque"
  description="Vendettas de Armwrestling Quezaltepeque: rivalidad, respeto y fuerza. Consulta los enfrentamientos y resultados de los eventos del club de lucha de brazos."
  canonical="/4eventos"
  ogImage="/fotos/eventos.webp"
  footer="eventos"
>
  <main>
    <section class="eventos-hero">
      <div class="eventos-hero-overlay"></div>
      <div class="eventos-hero-content">
        <span class="eventos-kicker">{evento.kicker}</span>
        <h1>{evento.nombre}</h1>
        <div class="eventos-hero-line"><span></span> RIVALIDAD <b>•</b> RESPETO <b>•</b> FUERZA <span></span>
        </div>

        <div class="eventos-meta-grid">
          <div class="eventos-meta">
            <i class="ri-calendar-event-fill"></i>
            <div><strong>{evento.fecha}</strong><span>{evento.horario}</span></div>
          </div>
          <div class="eventos-meta">
            <i class="ri-map-pin-2-fill"></i>
            <div><strong>{evento.lugar}</strong><span>{evento.lugarDetalle}</span></div>
          </div>
          <div class="eventos-meta">
            <i class="ri-group-fill"></i>
            <div><strong>Estado:</strong><span>{evento.estado}</span></div>
          </div>
        </div>
        <p class="eventos-hero-subtitle">Las viejas rivalidades vuelven a la mesa. <b>¿Estás preparado?</b></p>
      </div>
    </section>

    <section class="eventos-section" id="vendettas">
      <div class="eventos-section-heading fade-in">
        <h2>PARTICIPANTES</h2>
        <p>Estas son las vendettas confirmadas para el evento.</p>
      </div>

      <div class="matches-grid">
        {evento.matches.map(match => (
          <article class="match-card fade-in">
            <div class="match-label">{match.label}</div>
            <div class="fighters">
              {match.fighters.map((f, i) => (
                <>
                  {i > 0 && <div class="versus">VS</div>}
                  <a class="fighter" href={f.href}>
                    <div class="portrait">
                      <Image
                        src={foto(f.foto)}
                        widths={[200, 320, 440]}
                        sizes="(max-width: 700px) 38vw, 220px"
                        alt={f.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <strong>{f.nombre}</strong><span>{f.top}</span>
                    {f.resultado && <strong>{f.resultado}</strong>}
                  </a>
                </>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="eventos-info-strip fade-in">
      <div><i class="ri-calendar-event-fill"></i><span><small>FECHA Y HORA</small>{evento.fecha}<br>{evento.horario}</span></div>
      <div><i class="ri-map-pin-2-fill"></i><span><small>LUGAR</small>{evento.lugar}<br>{evento.lugarDetalle}</span></div>
      <div><i class="ri-group-fill"></i><span><small>FORMATO</small>Vendettas individuales<br>1 vs 1 · Mejor de
          5</span></div>
    </section>

    <section class="eventos-cta fade-in">
      <div class="eventos-cta-icon"><i class="ri-trophy-fill"></i></div>
      <div><strong>SÉ PARTE DE LA HISTORIA</strong><span>Las rivalidades hacen más fuerte al club.</span></div>
      <a href="/5contactos" class="btn-eventos">Unirme al club <i class="ri-arrow-right-line"></i></a>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: `Vendettas — ${site.nombre}`,
    description: 'Vendettas de lucha de brazos: rivalidad, respeto y fuerza. Enfrentamientos 1 vs 1, mejor de 5.',
    startDate: evento.fechaISO.inicio,
    endDate: evento.fechaISO.fin,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    image: [`${site.dominio}/fotos/eventos.webp`],
    location: {
      '@type': 'Place',
      name: evento.lugar,
      address: {
        '@type': 'PostalAddress',
        streetAddress: evento.lugar,
        addressLocality: 'Quezaltepeque',
        addressRegion: 'La Libertad',
        addressCountry: 'SV'
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.ubicacion.coords.lat,
        longitude: site.ubicacion.coords.lng
      }
    },
    organizer: {
      '@type': 'SportsOrganization',
      name: site.nombre,
      url: `${site.dominio}/`
    }
  })} />
</BaseLayout>
